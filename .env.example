APP_PORT=8080
APP_DATA_DIR=./data
APP_MEDIA_DIR=./data/uploads
APP_WEB_DIR=./web/dist
APP_VERSION=0.1.0
# Set this to true when the service is behind HTTPS.
APP_COOKIE_SECURE=false
# Optional comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
APP_TRUSTED_PROXIES=
# Session cookie lifetime in minutes. Invalid or out-of-range values use 1440.
APP_SESSION_TTL_MIN=1440
# HTTP response deadline; allow enough time for a full backup to be created and downloaded.
APP_WRITE_TIMEOUT=5m
# Maximum failed logins per client address in each 10-minute window; success clears the counter.
APP_LOGIN_FAILURE_LIMIT=5
# Maximum comments per client address in each 1-minute window.
APP_COMMENT_RATE_LIMIT=30
# Maximum password recovery requests per client address in each 15-minute window.
APP_PASSWORD_RESET_LIMIT=5
# Maximum password recovery emails per active account in each 15-minute window.
APP_PASSWORD_RESET_ACCOUNT_LIMIT=1
# SMTP is optional. Password recovery is disabled until a host and sender are set.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=
# Use starttls (usually port 587) or implicit (usually port 465).
APP_SMTP_TLS_MODE=starttls
